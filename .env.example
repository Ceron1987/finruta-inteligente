# ============================================================
# FinRuta Inteligente — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio. NUNCA pongas claves
# privadas (service_role, mapas, etc.) en código del cliente.
# ============================================================

# --- Supabase ---
# Dashboard de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para operaciones server-side (importación masiva, auditoría,
# backoffice). JAMÁS exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Mapas (opcional, para habilitar rutas reales) ---
# Si no se configura, el módulo de rutas sigue funcionando en MODO DEMO
# claramente etiquetado.
# Usa UNA de las dos: Mapbox O Google Maps.
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# --- App ---
# URL pública (ej. https://finruta.vercel.app o http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
